# Log Files
logs/
*.log

# Simulation result CSVs — per-run attack outputs (large, regenerated by
# run_std_attacks.py). The live results_routing/ lives outside this repo; this
# blanket rule covers any copies/backups kept inside it. Exception below keeps
# the committed sfto_pipeline/results/*.csv benchmark tables tracked.
backups/
attack1_prefix_backup/
*.csv
!sfto_pipeline/results/**/*.csv

# The repo-root results copy (hand-copied from the HPC) and the GUI's
# exported JSON snapshots of it -- both derived data, not source.
/results_routing/
/gui/snapshots/

# Evidence screenshots (Task 8 deliverables, local capture only)
screenshots/

# Simulation Output Files
routing.xml

# SUMO Intermediate Physics Files
fcd*.xml
fcd_output_*.xml
osm.passenger.trips.xml

# Compiled Object Files and Executables
*.o
*.so
*.a
*.out
*.exe
build/
bin/

# Python Cache
__pycache__/
*.pyc

# IDEs / OS files
.DS_Store
.vscode/
.idea/

# Blockchain / Hyperledger Fabric transient artifacts
blockchain/fabric-samples/test-network/organizations/
blockchain/fabric-samples/test-network/channel-artifacts/
blockchain/fabric-samples/test-network/system-genesis-block/
blockchain/fabric-samples/test-network/results_routing/
blockchain/bridge/node_modules/
blockchain/bridge/wallet/
blockchain/mobiguard-cc/vendor/
blockchain/mobiguard-cc/mobiguard-cc
*.tar.gz
*.block
docs/main (10).synctex(busy)
docs/main.aux
docs/main.fdb_latexmk
docs/main.synctex(busy)
docs/main.fls

CLAUDE.md
# ── Local backups / restore points (2026-09-01) ─────────────────────────────
# Timestamped safety copies made before a destructive pipeline step. They are
# hundreds of MB of .npy/.pt binaries and must never enter git: commit 43c4d24
# accidentally staged 370 MB of them (train_X.npy alone was 210 MB) before
# being rolled back. The originals they protect are already tracked.
lstm_pipeline/preprocessed_backup_*/
lstm_pipeline/preprocessed/
lstm_pipeline/restore_point_*/
lstm_pipeline/models_backup_*/
lstm_pipeline/*_backup_*.json
lstm_pipeline/*_backup_*.bin
# Raw arrays are regenerable from results_routing via preprocessor.py (~27 s).
*.npy
.venv-gui/

# Personal documents at the repo root -- logbooks, contribution templates,
# exported PDFs. These are the author's own files, not project artefacts, and
# must never be committed. docs/ is deliberately NOT covered: the .md write-ups
# there are project deliverables.
/*.docx
/*.pdf
/*.docx.bak
/*.doc
/.~lock.*#
