# LSTM pipeline generated artifacts — regenerated by pipeline.py each run.
# Paths are relative to this lstm_pipeline/ directory.

# Trained models (per-RSU + global .pt weights, ~46 MB) — tracked so
# teammates can pull them without rerunning the pipeline.
models_backup_*/

# Preprocessed windows / labels / meta (.npy arrays, ~35 MB)
preprocessed/

# Per-run pipeline outputs
evaluation_results.json
fed_summary.json
hparams.json
local_results.json
poison_sweep_results.json
scaler_params.json

# Kept tracked (do NOT ignore): the calibration deliverable, small and
# referenced by scratch/s1_detection.h and scratch/routing.cc —
#   calibrated_params.json
#   calibration_report.txt
